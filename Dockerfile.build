# Builds the exporter from source (the upstream Dockerfile expects a goreleaser binary).
FROM golang:1.27.3@sha256:921f61120011c774a7b37fd80bd3c3d259636090d3cd002b6a344322a0328082 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/starlink_exporter ./cmd/starlink_exporter

FROM gcr.io/distroless/static:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
COPY --from=build /out/starlink_exporter /starlink_exporter
USER 65532:65532
ENTRYPOINT ["/starlink_exporter"]
