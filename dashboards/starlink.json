{
  "uid": "starlink-dish",
  "title": "Starlink dish",
  "description": "Dish health, obstructions, throughput, latency, power and outages from johncarse/starlink_exporter.",
  "tags": [
    "starlink"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(starlink_dish_up, job)",
          "refId": "job"
        },
        "definition": "label_values(starlink_dish_up, job)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Dish rebooted",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(starlink_dish_boot_count{job=~\"$job\"}[5m]) > 0",
        "step": "60s",
        "titleFormat": "Dish rebooted",
        "tagKeys": "job"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "State now",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CONNECTED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (state) (starlink_dish_state{job=~\"$job\"}) == 1",
          "legendFormat": "{{state}}",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "The dish's current state, derived from its outage record. CONNECTED is the only healthy value.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ethernet speed",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "green",
                "value": 1000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "Mbits"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_eth_speed_mbps{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Negotiated speed of the cable between the dish and the router. Under 1000 Mbps means a damaged cable or connector.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Firmware",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (software_version) (starlink_dish_info{job=~\"$job\"})",
          "legendFormat": "{{software_version}}",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Software version reported by the dish.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_uptime_seconds{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Boots",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_boot_count{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Total number of times the dish has booted.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Obstructed now",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "clear",
                  "color": "green"
                },
                "1": {
                  "text": "obstructed",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_currently_obstructed{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Whether the dish currently reports its view of the sky as obstructed.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PoP latency / ping drop",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ping drop ratio"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_pop_ping_latency_seconds{job=~\"$job\"})",
          "legendFormat": "PoP latency",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_pop_ping_drop_ratio{job=~\"$job\"})",
          "legendFormat": "ping drop ratio",
          "refId": "B"
        }
      ],
      "description": "Round trip to the Starlink point of presence, and the share of pings lost, as seen by the dish."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Throughput (dish-reported)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_downlink_throughput_bps{job=~\"$job\"})",
          "legendFormat": "downlink",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_uplink_throughput_bps{job=~\"$job\"})",
          "legendFormat": "uplink",
          "refId": "B"
        }
      ],
      "description": "Current traffic through the dish. This is real traffic, not a capacity test."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Download: hourly p95 and max",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(quantile_over_time(0.95, starlink_dish_history_downlink_throughput_bps{job=~\"$job\",stat=\"p95\"}[1h]))",
          "legendFormat": "p95 (1h)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(max_over_time(starlink_dish_history_downlink_throughput_bps{job=~\"$job\",stat=\"max\"}[1h]))",
          "legendFormat": "max (1h)",
          "refId": "B"
        }
      ],
      "description": "Built from the dish's own 15 minute history summaries (900 samples at 1 Hz). Passive: it is the traffic that actually flowed, so it is a floor on capacity, not a speed test."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upload: hourly p95 and max",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(quantile_over_time(0.95, starlink_dish_history_uplink_throughput_bps{job=~\"$job\",stat=\"p95\"}[1h]))",
          "legendFormat": "p95 (1h)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(max_over_time(starlink_dish_history_uplink_throughput_bps{job=~\"$job\",stat=\"max\"}[1h]))",
          "legendFormat": "max (1h)",
          "refId": "B"
        }
      ],
      "description": "As for download, for the uplink."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "PoP latency: hourly p95",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(quantile_over_time(0.95, starlink_dish_history_pop_ping_latency_seconds{job=~\"$job\",stat=\"p95\"}[1h]))",
          "legendFormat": "p95 (1h)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(avg_over_time(starlink_dish_history_pop_ping_latency_seconds{job=~\"$job\",stat=\"mean\"}[1h]))",
          "legendFormat": "mean (1h)",
          "refId": "B"
        }
      ],
      "description": "Latency with samples where every ping was lost left out, so outages do not pull the percentile."
    },
    {
      "id": 12,
      "type": "table",
      "title": "Obstruction by compass sector (worst first)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 14,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Obstructed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.02
                    },
                    {
                      "color": "red",
                      "value": 0.1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Clear above"
            },
            "properties": [
              {
                "id": "unit",
                "value": "degree"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Observed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (sector) (starlink_dish_obstruction_sector_fraction{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (sector) (starlink_dish_obstruction_sector_clear_above_elevation_deg{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (sector) (starlink_dish_obstruction_sector_observed_fraction{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "The dish's obstruction map folded into 16 compass sectors. Obstructed is the share of observed sky in the sector with a weak signal; Clear above is the elevation from which the sector is clear, i.e. the top of the skyline. The map empties on every dish reboot and refills as satellites pass, so read Observed first: a sector with little coverage has not been measured yet.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "sector": "Sector",
              "Value #A": "Obstructed",
              "Value #B": "Clear above",
              "Value #C": "Observed"
            },
            "indexByName": {
              "sector": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Obstructed",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Obstructed share by sector",
      "gridPos": {
        "x": 14,
        "y": 20,
        "w": 10,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (sector) (starlink_dish_obstruction_sector_fraction{job=~\"$job\"}) > 0",
          "legendFormat": "{{sector}}",
          "refId": "A"
        }
      ],
      "description": "Only sectors with some obstruction are drawn. A drop to nothing after a reboot is the map emptying, not the trees leaving: check the Observed column."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Dish pointing",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_bore_sight_azimuth_deg{job=~\"$job\"})",
          "legendFormat": "azimuth",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_bore_sight_elevation_deg{job=~\"$job\"})",
          "legendFormat": "elevation",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_tilt_angle_deg{job=~\"$job\"})",
          "legendFormat": "tilt",
          "refId": "C"
        }
      ],
      "description": "Where the dish is pointing. The dish re-aligns itself, typically after a reboot."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Power draw",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "watt",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_power_input_watts{job=~\"$job\"})",
          "legendFormat": "now",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(starlink_dish_power_input_mean_watts{job=~\"$job\"})",
          "legendFormat": "mean (15m window)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(max_over_time(starlink_dish_power_input_watts{job=~\"$job\"}[1h]))",
          "legendFormat": "max (1h)",
          "refId": "C"
        }
      ],
      "description": "Input power from the dish history. Now is the newest 1 Hz sample, mean is over the dish's 15 minute window, max is the highest sample in the last hour."
