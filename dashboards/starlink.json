      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (cause) (increase(starlink_dish_outage_seconds_total{job=~\"$job\"}[$__rate_interval])) > 0",
